<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/tessAi/categories" method="GET">
        <service class="Combipower\TessAI\Api\CategoryManagementInterface" method="getList" />
        <resources>
            <resource ref="Combipower_TessAI::read" />
        </resources>
    </route>

    <route url="/V1/tessAi/filters" method="GET">
        <service class="Combipower\TessAI\Api\FilterManagementInterface" method="getOptions" />
        <resources>
            <resource ref="Combipower_TessAI::read" />
        </resources>
    </route>

    <route url="/V1/tessAi/products" method="GET">
        <service class="Combipower\TessAI\Api\ProductManagementInterface" method="getList" />
        <resources>
            <resource ref="Combipower_TessAI::read" />
        </resources>
    </route>

    <route url="/V1/tessAi/products/:sku" method="GET">
        <service class="Combipower\TessAI\Api\ProductManagementInterface" method="getBySku" />
        <resources>
            <resource ref="Combipower_TessAI::read" />
        </resources>
    </route>

    <route url="/V1/tessAi/prices" method="POST">
        <service class="Combipower\TessAI\Api\PriceUpdateManagementInterface" method="updatePrices" />
        <resources>
            <resource ref="Combipower_TessAI::write" />
        </resources>
    </route>
</routes>
